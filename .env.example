# ---- Payments (optional) ---------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run with every exercise unlocked (local dev).
# Setting it turns on the paywall: Push-ups & Lunges require FormAI Pro ($14.99/mo).
STRIPE_SECRET_KEY=

# Optional: a recurring Price ID from your Stripe dashboard (price_...).
# If omitted, checkout creates the $14.99/month price inline.
STRIPE_PRICE_ID=

# Optional: secret used to sign the subscription cookie. If omitted, one is
# derived from STRIPE_SECRET_KEY. Generate with: openssl rand -base64 32
FORMAI_COOKIE_SECRET=

# Optional: public URL used for Stripe redirect URLs (e.g. https://formai.vercel.app).
# Defaults to the request's origin.
NEXT_PUBLIC_SITE_URL=

# ---- Pose model (optional) -------------------------------------------------
# Override where the MediaPipe model / WASM are loaded from (e.g. to self-host the model).
NEXT_PUBLIC_POSE_MODEL_URL=
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=
