# ---- Payments ----------------------------------------------------------------
# FormAI is a paid product: every workout requires FormAI Pro ($14.99/month).
# In production the paywall is ALWAYS on. Without STRIPE_SECRET_KEY nobody can
# subscribe, so set it before you launch. (In `npm run dev` without a key, the
# paywall is off so you can work on pose tracking.)
STRIPE_SECRET_KEY=

# Optional: a recurring Price ID from your Stripe dashboard (price_...).
# If omitted, checkout creates the $14.99/month USD price inline.
STRIPE_PRICE_ID=

# Recommended: secret used to sign the subscription cookie and device links.
# If omitted, one is derived from STRIPE_SECRET_KEY. Generate: openssl rand -base64 32
FORMAI_COOKIE_SECRET=

# Recommended in production: your public URL, used for Stripe redirects and QR device links.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to turn the paywall off entirely (e.g. a private demo).
FORMAI_DISABLE_PAYWALL=

# Testing only: point the Stripe SDK at stripe-mock or e2e/mock-stripe.mjs.
STRIPE_API_BASE=

# ---- Your business details (shown on /terms, /privacy and /refunds) ----------
# Legal name of the person or company selling FormAI Pro.
FORMAI_BUSINESS_NAME=
# Support email for billing, refund and privacy requests (shown publicly).
FORMAI_SUPPORT_EMAIL=
# Governing law for the Terms, e.g. "the State of California, USA".
FORMAI_GOVERNING_LAW=

# ---- Pose model (optional) -----------------------------------------------------
# Override where the MediaPipe model / WASM are loaded from (e.g. to self-host the model).
NEXT_PUBLIC_POSE_MODEL_URL=
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=
